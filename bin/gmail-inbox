#!/usr/bin/env bash
# gmail-inbox — data source for the Omarchy Gmail bar widget.
#
# Everything goes through the Google Workspace CLI (`gws`), which owns the
# OAuth token; no credential of any kind passes through this script or its
# argument list.
#
#   gmail-inbox list             {"ok":true,"email":"...","unread":9,"messages":[...]}
#   gmail-inbox read <id>        mark one message as read
#   gmail-inbox unread <id>      put it back to unread
#   gmail-inbox read-all         mark every unread message in the inbox as read
#   gmail-inbox star <id>        add the star
#   gmail-inbox unstar <id>      take it off
#   gmail-inbox demo on          a plain fixed inbox, for screenshots
#   gmail-inbox demo fun         the same but written to be posted
#   gmail-inbox demo off
#
# Every write turns into a no-op while a demo is on, so a screenshot session
# can never touch a real mailbox.
#
# `list` costs two API calls on a warm cache. The subject, sender and
# read state come from one `+triage` call, so the unread dots are never
# stale. The snippet and the timestamp never change once a message exists,
# so those are cached per message id and only fetched for ids we have not
# seen before.
#
# Output is always a single JSON object. Failures print {"ok":false,...}
# and exit 0: a widget that gets no JSON has nothing to show but a crash.

set -uo pipefail
umask 077

# gws refuses to decrypt its token when it cannot reach the OS keyring, which
# is exactly the situation a Quickshell child process is in.
export GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND="${GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND:-file}"

# The shell is started by uwsm and does not necessarily inherit the login
# shell's PATH, so a version-manager shim directory is worth adding back.
for candidate in "$HOME/.local/share/mise/shims" "$HOME/.local/bin" "$HOME/.bun/bin"; do
  case ":$PATH:" in
    *":$candidate:"*) ;;
    *) [ -d "$candidate" ] && PATH="$PATH:$candidate" ;;
  esac
done
export PATH

QUERY="${OMARCHY_GMAIL_QUERY:-in:inbox}"
LABEL="${OMARCHY_GMAIL_LABEL:-INBOX}"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-gmail-inbox"
CACHE_FILE="$CACHE_DIR/messages.json"
PROFILE_FILE="$CACHE_DIR/profile.json"
LABEL_FILE="$CACHE_DIR/labels.json"
DEMO_FILE="$CACHE_DIR/demo"

die() {
  printf '{"ok":false,"error":%s}\n' "$(printf '%s' "$1" | jq -Rs .)"
  exit 0
}

# How many messages the panel lists. Clamped rather than trusted: this comes
# from the environment, and it ends up in an API request and in a loop bound.
max_messages() {
  local value="${OMARCHY_GMAIL_MAX:-20}"
  case "$value" in
    ''|*[!0-9]*) printf '20'; return 0 ;;
  esac
  [ "${#value}" -le 3 ] || { printf '20'; return 0; }
  local n=$((10#$value))
  [ "$n" -ge 1 ] || { printf '20'; return 0; }
  [ "$n" -le 50 ] || { printf '50'; return 0; }
  printf '%s' "$n"
}

# Message ids come back from the API, so they are input. They end up in a URL
# the browser opens and in an API request, and a value shaped like anything
# else is a sign the other side is not what we think it is — so refuse it
# rather than try to clean it up.
valid_id() {
  [[ "$1" =~ ^[0-9a-f]{1,32}$ ]]
}

# mkdir -p follows a symlink to a directory and reports success, and leaves
# the mode of a directory that was already there alone. Check the path itself
# afterwards, and repair what an older version may have left world-readable.
private_dir() {
  local dir="$1" owner mode
  mkdir -p -m 700 -- "$dir" 2>/dev/null
  [[ -d "$dir" && ! -L "$dir" ]] || return 1
  owner="$(stat -c '%u' -- "$dir" 2>/dev/null)" || return 1
  [[ "$owner" == "$(id -u)" ]] || return 1
  mode="$(stat -c '%a' -- "$dir" 2>/dev/null)"
  if [[ "$mode" != "700" ]]; then
    chmod 700 -- "$dir" 2>/dev/null || return 1
    find "$dir" -maxdepth 1 -type f -exec chmod 600 -- {} + 2>/dev/null
  fi
}

command -v jq >/dev/null 2>&1 || die "jq not found on PATH"

private_dir "$CACHE_DIR" || die "cache directory is not usable"

# A cache file that is not a JSON object takes jq down with it, and --slurpfile
# fails the whole run rather than the one lookup. That would leave the widget
# permanently broken over a file it can perfectly well rebuild, so check the
# shape once and start over when it is wrong.
ensure_json_object() {
  local file="$1"
  [ -r "$file" ] && jq -e 'type == "object"' -- "$file" >/dev/null 2>&1 && return 0
  printf '{}\n' > "$file"
}

demo_on() { [ -e "$DEMO_FILE" ]; }

demo_on || command -v gws >/dev/null 2>&1 || die "gws not found on PATH — see the README"

gws_gmail() {
  gws gmail "$@" 2>/dev/null
}

# ------------------------------------------------------------------ profile
#
# Only needed for the /mail/u/<address>/ part of the message URL, so that the
# right account opens on a browser signed in to several. It never changes;
# fetch it once and keep it.
account_email() {
  local cached email
  if [ -r "$PROFILE_FILE" ]; then
    cached="$(jq -r '.emailAddress // empty' "$PROFILE_FILE" 2>/dev/null)"
    [ -n "$cached" ] && { printf '%s' "$cached"; return 0; }
  fi
  email="$(gws_gmail users getProfile --params '{"userId":"me"}' \
    | jq -r '.emailAddress // empty' 2>/dev/null)"
  [ -n "$email" ] || return 1
  printf '{"emailAddress":%s}\n' "$(printf '%s' "$email" | jq -Rs .)" > "$PROFILE_FILE"
  printf '%s' "$email"
}

# ------------------------------------------------------------------- list

cmd_list() {
  local max triage notice errfile messages counts unread total email
  max="$(max_messages)"

  # An empty result is not an error, but +triage reports it as a plain-text
  # line on stderr and still exits 0, leaving stdout empty. Keep that stream
  # rather than discarding it: without it an empty inbox — the one case where
  # you most want to believe the widget — reads as an unreachable account.
  errfile="$(mktemp "${TMPDIR:-/tmp}/omarchy-gmail-inbox-err.XXXXXX")" || errfile=""
  if [ -n "$errfile" ]; then
    triage="$(gws gmail +triage --query "$QUERY" --max "$max" --labels --format json 2>"$errfile")"
    notice="$(cat -- "$errfile" 2>/dev/null)"
    rm -f -- "$errfile"
  else
    triage="$(gws_gmail +triage --query "$QUERY" --max "$max" --labels --format json)"
    notice=""
  fi

  messages="$(printf '%s' "$triage" | jq -c '[.messages[]?]' 2>/dev/null)"
  if [ -z "$messages" ]; then
    case "$notice" in
      *"No messages found"*) messages='[]' ;;
      *) die "could not read the inbox — is gws authenticated?" ;;
    esac
  fi

  # Exact counts for the whole label, not just the page we list, so the badge
  # and the title keep describing the inbox rather than the visible slice.
  # Both come out of the one call.
  counts="$(gws_gmail users labels get --params "$(jq -nc --arg id "$LABEL" '{userId:"me",id:$id}')")"
  unread="$(printf '%s' "$counts" | jq -r '.messagesUnread // empty' 2>/dev/null)"
  total="$(printf '%s' "$counts" | jq -r '.messagesTotal // empty' 2>/dev/null)"
  case "$unread" in ''|*[!0-9]*) unread=0 ;; esac
  case "$total" in ''|*[!0-9]*) total=0 ;; esac

  email="$(account_email)" || email=""

  ensure_json_object "$CACHE_FILE"
  ensure_json_object "$LABEL_FILE"
  fill_cache "$messages"
  fill_labels "$messages"
  render "$messages" "$unread" "$total" "$email"
}

# Your own labels come back as ids ("Label_8071185..."), never as the names you
# gave them, so they need a lookup table. Names change rarely, and a new one
# announces itself by turning up as an id we cannot resolve — so the table is
# only refetched when that happens, and costs nothing the rest of the time.
fill_labels() {
  local messages="$1" unknown fetched

  unknown="$(jq -r --slurpfile map "$LABEL_FILE" '
      [ .[] | (.labels // [])[] | select(startswith("Label_")) ]
      | map(select($map[0][.] == null))
      | length
    ' <<<"$messages" 2>/dev/null)"
  case "$unknown" in ''|*[!0-9]*) return 0 ;; 0) return 0 ;; esac

  # Nested labels arrive as "parent/child"; the leaf is what identifies the
  # label at a glance, and the full path never fits in a chip anyway.
  fetched="$(gws_gmail users labels list --params '{"userId":"me"}' \
    | jq -c '[.labels[]? | select(.type == "user")
              | {key: .id, value: (.name | split("/") | last)}] | from_entries' 2>/dev/null)"
  [ -n "$fetched" ] && printf '%s\n' "$fetched" > "$LABEL_FILE"
}

# Fetch snippet and timestamp for every id we have never seen. Both are fixed
# for the life of a message, so this runs once per message and a refresh of an
# unchanged inbox costs nothing.
fill_cache() {
  local messages="$1" missing tmp id attach

  missing="$(jq -r --slurpfile cache "$CACHE_FILE" '
      [.[] | .id | select(. != null)]
      | map(select($cache[0][.] == null))
      | .[]
    ' <<<"$messages" 2>/dev/null)"
  [ -n "$missing" ] || return 0

  tmp="$(mktemp -d "${TMPDIR:-/tmp}/omarchy-gmail-inbox.XXXXXX")" || return 0

  # Whether a message carries an attachment is not in the triage output and not
  # in the metadata format either — only `format:full` has the part list, and
  # that drags the whole body along. One search settles it for the entire page
  # instead, and since it never changes for a given message it is cached with
  # the rest and only ever asked once.
  attach="$(gws_gmail users messages list \
      --params "$(jq -nc --arg q "$QUERY has:attachment" --argjson n "$(max_messages)" \
                    '{userId:"me",q:$q,maxResults:$n}')" \
    | jq -c '[.messages[]?.id | select(test("^[0-9a-f]{1,32}$"))]' 2>/dev/null)"
  case "$attach" in ''|*[!0-9a-f\[\]\",]*) attach='[]' ;; esac

  # The id reaches the worker as an argument, never spliced into its source by
  # xargs. It is already filtered to hex above, but a value from the API has no
  # business being substituted into a shell script either way.
  while IFS= read -r id; do
    valid_id "$id" || continue
    printf '%s\n' "$id"
  done <<<"$missing" | xargs -r -P 6 -I {} bash -c '
      id="$1"
      out="$2"
      params=$(jq -nc --arg id "$id" \
        "{userId:\"me\",id:\$id,format:\"metadata\",metadataHeaders:[\"Subject\"]}")
      gws gmail users messages get --params "$params" 2>/dev/null \
        | jq -c "{(.id): {snippet: (.snippet // \"\"), ts: ((.internalDate // \"0\") | tonumber? // 0), threadId: (.threadId // .id)}}" \
        > "$out/$id.json" 2>/dev/null
    ' _ {} "$tmp"

  # Merge in one go and keep the file bounded: an inbox churns, and a cache
  # that only ever grows is a log of everything that passed through it.
  local merged
  merged="$(jq -s --argjson attach "$attach" '
      (.[0] // {}) as $old
      | ($attach | map({(.): true}) | add // {}) as $hasattachment
      | reduce .[1:][] as $entry ($old;
          . + ($entry | to_entries
                      | map(.value.att = ($hasattachment[.key] // false))
                      | from_entries))
      | to_entries
      | sort_by(-(.value.ts // 0))
      | .[0:500]
      | from_entries
    ' "$CACHE_FILE" "$tmp"/*.json 2>/dev/null)"
  [ -n "$merged" ] && printf '%s\n' "$merged" > "$CACHE_FILE"

  rm -rf -- "$tmp"
}

# Everything the panel draws, shaped here rather than in QML: the widget
# should render a list, not parse mail headers.
render() {
  local messages="$1" unread="$2" total="$3" email="$4"
  jq -nc \
    --argjson messages "$messages" \
    --slurpfile cache "$CACHE_FILE" \
    --slurpfile labelmap "$LABEL_FILE" \
    --argjson unread "$unread" \
    --argjson total "$total" \
    --arg email "$email" '
    def entity:
      gsub("&lt;";"<") | gsub("&gt;";">") | gsub("&quot;";"\"")
      | gsub("&#39;";"'"'"'") | gsub("&nbsp;";" ") | gsub("&amp;";"&");

    # "Denise <denise@example.com>" reads as a person; the address alone does
    # not. Fall back to the address when there is no display name.
    def sender:
      . as $raw
      | (capture("^\\s*\"?(?<name>[^\"<]*?)\"?\\s*<(?<addr>[^>]+)>\\s*$") // null) as $m
      | if $m == null then ($raw | ltrimstr(" ") | rtrimstr(" "))
        elif ($m.name | length) > 0 then $m.name
        else $m.addr end;

    ($labelmap[0] // {}) as $names
    # Gmail hangs a dozen bookkeeping labels on every message — INBOX, the
    # CATEGORY_ tabs, IMPORTANT, the star colour. Only the ones you made
    # yourself say anything a reader did not already know.
    | def mine: [ .[] | select(startswith("Label_")) | $names[.] | select(. != null) ];

    ($cache[0] // {}) as $c
    | {
        ok: true,
        email: $email,
        unread: $unread,
        total: $total,
        messages: [
          $messages[]
          | select(.id != null)
          | . as $m
          | ($c[$m.id] // {}) as $extra
          | {
              id: $m.id,
              threadId: ($extra.threadId // $m.id),
              subject: ((($m.subject // "") | entity) as $s
                        | if ($s | length) > 0 then $s else "(no subject)" end),
              from: (($m.from // "") | entity | sender),
              snippet: (($extra.snippet // "") | entity),
              ts: (($extra.ts // 0) / 1000 | floor),
              unread: (($m.labels // []) | index("UNREAD") != null),
              starred: (($m.labels // []) | index("STARRED") != null),
              attachment: ($extra.att // false),
              labels: (($m.labels // []) | mine)
            }
        ]
        | sort_by(-.ts)
      }'
}

# ------------------------------------------------------------------ writes

cmd_read() {
  local id="${1:-}" action="${2:-read}" body
  valid_id "$id" || die "not a message id"
  case "$action" in
    read)   body='{"removeLabelIds":["UNREAD"]}' ;;
    unread) body='{"addLabelIds":["UNREAD"]}' ;;
    *)      die "unknown read action" ;;
  esac
  gws_gmail users messages modify \
    --params "$(jq -nc --arg id "$id" '{userId:"me",id:$id}')" \
    --json "$body" >/dev/null || die "could not change the read state"
  printf '{"ok":true}\n'
}

cmd_star() {
  local id="${1:-}" action="${2:-}" body
  valid_id "$id" || die "not a message id"
  case "$action" in
    star)   body='{"addLabelIds":["STARRED"]}' ;;
    unstar) body='{"removeLabelIds":["STARRED"]}' ;;
    *)      die "unknown star action" ;;
  esac
  gws_gmail users messages modify \
    --params "$(jq -nc --arg id "$id" '{userId:"me",id:$id}')" \
    --json "$body" >/dev/null || die "could not change the star"
  printf '{"ok":true}\n'
}

cmd_read_all() {
  local page ids token batch body count marked=0 rounds=0

  # Everything unread in the label, not only what the panel happens to list —
  # "mark all as read" that leaves some behind is worse than no button. One
  # request caps at 500 ids and hands back a nextPageToken for the rest, so a
  # single call silently stops there: on a label with 3383 unread it would
  # clear 500 and leave 2883 behind, with the badge as the only hint. Walk the
  # pages instead. The round cap is a runaway guard, not a limit anyone reaches
  # — 40 pages is 20.000 messages.
  while [ "$rounds" -lt 40 ]; do
    rounds=$((rounds + 1))
    page="$(gws_gmail users messages list --params "$(
      jq -nc --arg q "is:unread $QUERY" --arg t "${token:-}" \
        '{userId:"me",q:$q,maxResults:500} + (if $t == "" then {} else {pageToken:$t} end)')")"
    ids="$(printf '%s' "$page" \
      | jq -c '[.messages[]?.id | select(test("^[0-9a-f]{1,32}$"))]' 2>/dev/null)"
    [ -n "$ids" ] || { [ "$marked" -gt 0 ] && break; die "could not list unread messages"; }

    count="$(jq 'length' <<<"$ids")"
    case "$count" in ''|*[!0-9]*) die "could not count unread messages" ;; esac

    if [ "$count" != "0" ]; then
      # batchModify takes at most 1000 ids per call, so a 500-id page always
      # fits in one.
      body="$(jq -nc --argjson ids "$ids" '{ids:$ids,removeLabelIds:["UNREAD"]}')"
      gws_gmail users messages batchModify --params '{"userId":"me"}' --json "$body" >/dev/null \
        || die "could not mark all as read"
      marked=$((marked + count))
    fi

    token="$(printf '%s' "$page" | jq -r '.nextPageToken // empty' 2>/dev/null)"
    [ -n "$token" ] || break
  done

  printf '{"ok":true,"marked":%s}\n' "$marked"
}

# -------------------------------------------------------------------- demo
#
# A fixed inbox for screenshots and for trying the panel out without an
# account. Ages are relative to now, so the "4m / 2h / 1d" column stays honest
# however long the demo has been switched on.
cmd_demo() {
  case "${1:-}" in
    on)  printf 'plain\n' > "$DEMO_FILE"; printf '{"ok":true,"demo":"plain"}\n' ;;
    fun) printf 'fun\n' > "$DEMO_FILE"; printf '{"ok":true,"demo":"fun"}\n' ;;
    off) rm -f -- "$DEMO_FILE"; printf '{"ok":true,"demo":false}\n' ;;
    *)   die "demo takes on, fun or off" ;;
  esac
}

demo_list() {
  case "$(head -n1 -- "$DEMO_FILE" 2>/dev/null)" in
    fun) demo_fun ;;
    *)   demo_plain ;;
  esac
}

# A quieter inbox, for the readme: it has to show what a row is made of
# without the reader having to get the joke first.
demo_plain() {
  jq -nc --argjson now "$(date +%s)" '
    def m($id; $mins; $from; $subject; $snippet; $unread; $starred; $labels):
      { id: $id, threadId: $id, subject: $subject, from: $from,
        snippet: $snippet, ts: ($now - ($mins * 60)),
        unread: $unread, starred: $starred, labels: $labels };
    {
      ok: true,
      email: "you@example.com",
      messages: [
        m("d000000000000a01"; 4;    "Priya Raghunathan"; "Re: Friday demo — moved to 3pm";
          "Works for me. I moved the room booking too, so we have the big screen this time.";
          true; false; []),
        m("d000000000000a02"; 38;   "Tom Bakker";        "Invoice 2026-0841 is overdue";
          "Hi, our records show invoice 2026-0841 has not been paid yet. Could you check whether";
          true; true; ["billing"]),
        m("d000000000000a03"; 95;   "GitHub";            "Pull request opened";
          "sam-dev wants to merge 3 commits into main from fix/badge-width. Files changed: 2";
          true; false; ["github"]),
        m("d000000000000a04"; 180;  "Anna Kowalski";     "Notes from the architecture review";
          "Attached are the notes. The main open question is whether we keep the cache in front";
          true; true; ["team"]),
        m("d000000000000a05"; 420;  "Fly.io";            "Deployment finished for wandering-fog-4821";
          "Your app was deployed successfully. 2 machines updated in ams. View the release at";
          false; false; []),
        m("d000000000000a06"; 1300; "Marc Delacroix";    "Lunch next week?";
          "I am in town Tuesday through Thursday. Any of those work for you? Happy to come by";
          true; false; []),
        m("d000000000000a07"; 2600; "Stripe";            "Your payout of €1,284.00 is on the way";
          "This payout should arrive in your bank account on Monday. It covers 41 payments made";
          false; false; ["billing"]),
        m("d000000000000a08"; 4400; "Linear";            "3 issues assigned to you this week";
          "ENG-412 Panel drops keyboard focus, ENG-418 Snippet cache grows without bound, ENG-";
          false; false; ["team"])
      ]
    }
    | .unread = ([.messages[] | select(.unread)] | length)
    | .total = (.messages | length)'
}

# The one for posting. These are real GitHub notifications from public
# open-source repositories, trimmed to fit: nothing here is private mail, and
# nothing here is invented.
demo_fun() {
  jq -nc --argjson now "$(date +%s)" '
    def m($id; $mins; $from; $subject; $snippet; $unread; $starred; $labels):
      { id: $id, threadId: $id, subject: $subject, from: $from,
        snippet: $snippet, ts: ($now - ($mins * 60)),
        unread: $unread, starred: $starred, labels: $labels };
    {
      ok: true,
      email: "you@example.com",
      messages: [
        m("d000000000000b01"; 8;    "Tobias Lütke";
          "Re: [tobi/omasnap] feat(editor): show the pixel size of the frame you are drawing (PR #72)";
          "Merged #72 into main.";
          true; true; ["github"]),
        m("d000000000000b02"; 35;   "David Heinemeier Hansson";
          "Re: [basecamp/omarchy] Quattro (PR #6231)";
          "No. Everything is tightly integrated.";
          true; false; []),
        m("d000000000000b03"; 130;  "HANCORE";
          "Re: [HANCORE-linux/omarchy-plugin-marketplace] [Verify]: Omasweeper (Issue #1149)";
          "Manual static review found a stale bar-layout migration and an input race before restore";
          true; false; ["github"]),
        m("d000000000000b04"; 260;  "Anthony";
          "Re: [tobi/omasnap] feat(editor): show the pixel size of the frame (PR #72)";
          "Thanks for working on this! I opened a similar discussion on the Omarchy repo last week";
          true; false; []),
        m("d000000000000b05"; 490;  "Jeff Yang";
          "Re: [basecamp/omarchy] Quattro (PR #6231)";
          "Would it be possible to release Quattro as a standalone package for other distributions?";
          true; false; []),
        m("d000000000000b06"; 1380; "Geert-Johan Riemer";
          "[jankeesvw/omarchy-unifi-protect] Restart the watcher once the settings arrive (PR #3)";
          "The bar assigns a widget its settings from a Qt.callLater, one event-loop turn later";
          true; false; []),
        m("d000000000000b07"; 1700; "Copilot";
          "Re: [basecamp/omarchy] Add a notifications.position setting for centered toasts (PR #7367)";
          "Copilot was unable to run its full agentic suite in this review.";
          false; false; ["github"]),
        m("d000000000000b08"; 2100; "github-actions[bot]";
          "Re: [HANCORE-linux/omarchy-plugin-marketplace] [Verify]: Omasweeper (Issue #1149)";
          "Closed #1149 as completed.";
          false; false; ["github"]),
        m("d000000000000b09"; 9800; "David Heinemeier Hansson";
          "[basecamp/omarchy] Release v4.0.0 - v4.0.0";
          "Tag: v4.0.0 · Commit: f002044 · Released by: dhh. The Quattro Release.";
          false; true; [])
      ]
    }
    | .unread = ([.messages[] | select(.unread)] | length)
    | .total = (.messages | length)'
}

case "${1:-list}" in
  list)     if demo_on; then demo_list; else cmd_list; fi ;;
  read)     if demo_on; then printf '{"ok":true}\n'; else cmd_read "${2:-}" read; fi ;;
  unread)   if demo_on; then printf '{"ok":true}\n'; else cmd_read "${2:-}" unread; fi ;;
  read-all) if demo_on; then printf '{"ok":true,"marked":0}\n'; else cmd_read_all; fi ;;
  star)     if demo_on; then printf '{"ok":true}\n'; else cmd_star "${2:-}" star; fi ;;
  unstar)   if demo_on; then printf '{"ok":true}\n'; else cmd_star "${2:-}" unstar; fi ;;
  demo)     cmd_demo "${2:-}" ;;
  *)        die "unknown command" ;;
esac
