    | (if $unreadOnly != "" then map(select(.unread)) else . end) as $all
    | ($all | length) as $count
    | (($page - 1) * $size) as $offset
    | {
        ok: true,
        email: "you@example.com",
        total: $count,
        unread: ([$all[] | select(.unread)] | length),
        nextPage: (if $offset + $size < $count then ($page + 1 | tostring) else "" end),
        thisPage: ($page | tostring),
        unreadOnly: ($unreadOnly != ""),
        messages: $all[$offset : $offset + $size]
      }'
}

case "${1:-list}" in
  list)     shift; if demo_on; then demo_list "$@"; else cmd_list "$@"; fi ;;
  read)     if demo_on; then printf '{"ok":true}\n'; else cmd_read "${2:-}" read; fi ;;
  unread)   if demo_on; then printf '{"ok":true}\n'; else cmd_read "${2:-}" unread; fi ;;
  read-all) if demo_on; then printf '{"ok":true,"marked":0}\n'; else cmd_read_all; fi ;;
  star)     if demo_on; then printf '{"ok":true}\n'; else cmd_star "${2:-}" star; fi ;;
  unstar)   if demo_on; then printf '{"ok":true}\n'; else cmd_star "${2:-}" unstar; fi ;;
  demo)     cmd_demo "${2:-}" ;;
  *)        die "unknown command" ;;
esac
